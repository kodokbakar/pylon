{
  "uid": "pylon-kafka",
  "title": "Pylon Kafka",
  "tags": ["pylon", "kafka"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Messages Published/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(pylon_kafka_messages_published_total[5m]))",
          "legendFormat": "{{topic}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 2,
      "title": "Publish Duration P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, topic) (rate(pylon_kafka_publish_duration_seconds_bucket[5m])))",
          "legendFormat": "{{topic}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 3,
      "title": "Messages Consumed/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic, consumer_group) (rate(pylon_kafka_messages_consumed_total[5m]))",
          "legendFormat": "{{topic}} {{consumer_group}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 4,
      "title": "Consumer Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic, group) (kafka_consumergroup_lag{group=~\".*pylon.*|notification-consumer-group\"})",
          "legendFormat": "{{topic}} {{group}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 5,
      "title": "Kafka Broker Messages In/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total[5m]))",
          "legendFormat": "{{topic}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 6,
      "title": "Kafka Produce Error Proxy",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_failedproducerequests_total[5m]))",
          "legendFormat": "{{topic}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    }
  ]
}