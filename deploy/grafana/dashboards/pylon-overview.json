{
  "uid": "pylon-overview",
  "title": "Pylon Overview",
  "tags": ["pylon", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Total HTTP Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pylon_http_requests_total)",
          "legendFormat": "HTTP Requests",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 2,
      "title": "Active WebSocket Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pylon_websocket_connections_active)",
          "legendFormat": "Connections",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 3,
      "title": "Users Online",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "pylon_users_online",
          "legendFormat": "Users Online",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 4,
      "title": "Messages Sent",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pylon_messages_sent_total)",
          "legendFormat": "Messages",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 5,
      "title": "Request Rate by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, path) (rate(pylon_http_requests_total[5m]))",
          "legendFormat": "HTTP {{method}} {{path}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        },
        {
          "refId": "B",
          "expr": "sum by (service, method) (rate(pylon_grpc_requests_total[5m]))",
          "legendFormat": "gRPC {{service}} {{method}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 6,
      "title": "Request Duration P50/P95/P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pylon_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "HTTP P50",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pylon_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "HTTP P95",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pylon_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "HTTP P99",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pylon_grpc_request_duration_seconds_bucket[5m])))",
          "legendFormat": "gRPC P95",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 7,
      "title": "Error Rate by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(pylon_http_requests_total{status_code=~\"5..\"}[5m]))",
          "legendFormat": "HTTP {{path}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        },
        {
          "refId": "B",
          "expr": "sum by (service) (rate(pylon_grpc_requests_total{status_code=~\"5..\"}[5m]))",
          "legendFormat": "gRPC {{service}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 8,
      "title": "Error Rate by Status Code",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(pylon_http_requests_total{status_code=~\"4..|5..\"}[5m]))",
          "legendFormat": "HTTP {{status_code}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        },
        {
          "refId": "B",
          "expr": "sum by (status_code) (rate(pylon_grpc_requests_total{status_code=~\"4..|5..\"}[5m]))",
          "legendFormat": "gRPC {{status_code}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    }
  ]
}