{
  "uid": "pylon-microservices",
  "title": "Pylon Microservices",
  "tags": ["pylon", "microservices"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "gRPC Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, method, status_code) (rate(pylon_grpc_requests_total[5m]))",
          "legendFormat": "{{service}} {{method}} {{status_code}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 2,
      "title": "gRPC Request Duration P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service, method) (rate(pylon_grpc_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}} {{method}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 3,
      "title": "gRPC Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pylon_grpc_requests_total{status_code=~\"4..|5..\"}[5m]))",
          "legendFormat": "Errors/sec",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 4,
      "title": "Pod CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"pylon\", container!=\"\", pod=~\".*service.*|.*gateway.*\"}[5m]))",
          "legendFormat": "{{pod}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 5,
      "title": "Pod Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"pylon\", container!=\"\", pod=~\".*service.*|.*gateway.*\"})",
          "legendFormat": "{{pod}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "id": 6,
      "title": "Pod Network I/O",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"pylon\"}[5m]))",
          "legendFormat": "rx {{pod}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"pylon\"}[5m]))",
          "legendFormat": "tx {{pod}}",
          "datasource": { "type": "prometheus", "uid": "Prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    }
  ]
}