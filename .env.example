# ===========================================
# Pylon - Environment Configuration
# ===========================================

# App
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgres://pylon:pylon_dev@localhost:5432/pylon?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=pylon

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Services
CHAT_SERVICE_URL=localhost:9091
PRESENCE_SERVICE_URL=localhost:9092
ROOM_SERVICE_URL=localhost:9093
NOTIFICATION_SERVICE_URL=localhost:9094

# WebSocket
WS_MAX_CONNECTIONS=1000
WS_READ_BUFFER_SIZE=4096
WS_WRITE_BUFFER_SIZE=4096
