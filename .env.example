# ===========================================
# Pylon - Environment Configuration
# ===========================================

# App
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgres://pylon:pylon_dev@localhost:5432/pylon?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=pylon

# JWT
# Required by docker-compose.yml. Do not use this value in production.
JWT_SECRET=change-me-local-development-secret
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Services
CHAT_SERVICE_URL=http://localhost:9001
PRESENCE_SERVICE_URL=http://localhost:9002
ROOM_SERVICE_URL=http://localhost:9003
NOTIFICATION_SERVICE_URL=http://localhost:9004

# WebSocket
WS_MAX_CONNECTIONS=1000
WS_READ_BUFFER_SIZE=4096
WS_WRITE_BUFFER_SIZE=4096
WS_INSECURE_SKIP_VERIFY=false

# gRPC
GRPC_PORT=9001
PRESENCE_GRPC_PORT=9002
ROOM_GRPC_PORT=9003
NOTIFICATION_GRPC_PORT=9004

# OpenTelemetry
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_VERSION=1.0.0
OTEL_TRACES_SAMPLE_RATIO=1

# Docker Compose local ports
PYLON_WEB_PORT=3000
API_GATEWAY_PORT=8080
CHAT_SERVICE_PORT=9001
PRESENCE_SERVICE_PORT=9002
ROOM_SERVICE_PORT=9003
NOTIFICATION_SERVICE_PORT=9004
POSTGRES_PORT=5433
REDIS_PORT=6380
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=9093
KAFKA_UI_PORT=8085
ZOOKEEPER_PORT=2181
JAEGER_UI_PORT=16686
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# Browser-facing frontend API URL.
# Keep localhost for local compose because browser cannot resolve Docker service names.
PYLON_WEB_API_URL=http://localhost:8080

# Docker Compose service credentials
POSTGRES_USER=pylon
POSTGRES_PASSWORD=pylon_dev
POSTGRES_DB=pylon