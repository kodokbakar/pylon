{
	"name": "pylon-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "playwright install chromium",
		"codegen": "rm -rf src/gen && mkdir -p src/gen && protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --plugin=protoc-gen-connect-es=./node_modules/.bin/protoc-gen-connect-es --es_out src/gen --es_opt target=ts --connect-es_out src/gen --connect-es_opt target=ts -I ../proto $(find ../proto -name '*.proto' | sort)",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run"
	},
	"devDependencies": {
		"@bufbuild/protoc-gen-es": "^2.12.1",
		"@connectrpc/protoc-gen-connect-es": "^1.7.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.12.1",
		"@connectrpc/connect": "^2.1.2",
		"@connectrpc/connect-web": "^2.1.2",
		"lucide-svelte": "^1.0.1",
		"svelte-sonner": "^1.1.1"
	}
}